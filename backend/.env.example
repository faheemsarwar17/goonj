# =============================================================================
# Audio Transcript Application - Backend Configuration
# =============================================================================
# Copy this file to .env and update the values with your actual configuration
# DO NOT commit the .env file to version control
# =============================================================================

# Application Settings
APP_NAME=Audio Transcript API
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
# MySQL connection string format: mysql+pymysql://username:password@host:port/database_name
# Example: mysql+pymysql://user:password@localhost:3306/audio_transcript
DATABASE_URL=mysql+pymysql://your_username:your_password@localhost:3306/transcript_app
DATABASE_ECHO=False

# Security Configuration
# IMPORTANT: Generate a strong secret key for production using: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Comma-separated list of allowed origins (frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# File Storage Configuration
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=100
ALLOWED_AUDIO_FORMATS=.wav,.mp3,.m4a,.webm,.ogg

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
# Model for audio transcription and diarization
OPENAI_MODEL=gpt-4o-transcribe-diarize

# Initial Admin User
# This user will be created automatically on first startup
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme
FIRST_ADMIN_NAME=System Administrator
