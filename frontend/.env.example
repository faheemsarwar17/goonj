# =============================================================================
# Audio Transcript Application - Frontend Configuration
# =============================================================================
# Copy this file to .env.local and update the values with your actual configuration
# Note: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# DO NOT commit .env.local to version control
# =============================================================================

# Backend API URL
# This is the URL where the backend API is running
# Development: http://localhost:8000
# Production: https://your-api-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
